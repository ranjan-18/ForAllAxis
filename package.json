{
  "name": "forallaxis",
  "version": "1.0.0",
  "description": "ForallAxis Agency Website - MERN Stack",
  "private": true,
  "workspaces": ["client-public", "client-admin", "server", "shared"],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:public\" \"npm run dev:admin\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:public": "npm run dev --workspace=client-public",
    "dev:admin": "npm run dev --workspace=client-admin",
    "build": "concurrently \"npm run build --workspace=client-public\" \"npm run build --workspace=client-admin\"",
    "start": "npm run start --workspace=server",
    "lint": "concurrently \"npm run lint --workspace=server\" \"npm run lint --workspace=client-public\" \"npm run lint --workspace=client-admin\"",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
